# ElevenLabs -- voiceover (Text to Speech scope) AND sound effects (Sound
# Effects scope). The older archcanvas-promo-video used SFX only; this film has
# a voiceover, so the key needs BOTH scopes.
#
# The founder keeps the live key in ../archcanvas/.env.local. scripts/*.mjs read
# this file via `node --env-file=.env`, so copy only the one line across.
ELEVENLABS_API_KEY=sk_your_key_here

# Voice id for the narration. Chosen from candidates rendered by
# `node --env-file=.env scripts/generate-vo.mjs --audition`.
ELEVENLABS_VOICE_ID=
