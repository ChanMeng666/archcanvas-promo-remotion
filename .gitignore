node_modules/
.env

# public/ is the staged asset tree. Most of it is copied out of
# ../archcanvas-promo-video by scripts/sync-assets.mjs, or cut from the raw OBS
# takes in D:ideos by scripts/cut-clips.mjs, and all of that is regenerable
# and uninteresting in a diff -- so it is not tracked. src/data/assets.json IS
# tracked; it is the ledger that says which bytes the film was cut from.
#
# The music bed is the exception, and the line is this: material that was COPIED
# from somewhere else or can be RE-RENDERED stays out; material that cannot be
# reproduced comes in. SUNO will not return the same track twice, so the source
# take is tracked, and so is the cut bed -- 5 MB between them, against a repo
# that could not otherwise render its own film.
#
# (Twelve ElevenLabs files were tracked here for exactly that reason between
# 90693b2 and the licensing removal. See docs/decisions.md D11.)
public/*
!public/.gitkeep
!public/audio/
public/audio/*
!public/audio/bgm.mp3

# The SUNO take the bed is cut from. Tracked: it is the irreplaceable original,
# and public/audio/bgm.mp3 is only a window of it -- the exact window, gain and
# fade are recorded in docs/suno-prompt.md so the cut is reproducible from here.
audio/source/*
!audio/source/.gitkeep
!audio/source/confident-arrival.mp3

# Renders.
#
# An 85s 1080p master is ~90MB per aspect ratio and git keeps every version
# forever. Four formats times a few review renders is a permanent gigabyte in a
# repo people clone to read a few thousand lines of TypeScript. Masters ship as
# GitHub Release assets.
#
# The sidecars are text and they are the reviewable record of what the film
# says, so they stay.
out/*
!out/*.srt
!out/*.vtt
